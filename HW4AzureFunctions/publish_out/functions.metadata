[
  {
    "name": "AttachmentZipFunction",
    "scriptFile": "HW4AzureFunctions.dll",
    "entryPoint": "HW4AzureFunctions.AttachmentZipFunction.Run",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "request",
        "direction": "In",
        "type": "queueTrigger",
        "queueName": "attachment-zip-requests",
        "connection": "AttachmentZipRequests",
        "properties": {}
      }
    ]
  }
]